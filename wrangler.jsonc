{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nabzesardo-cloudflare",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CLOUDFLARE_WORKER": "1",
    "DATA_DIR": "/tmp/nabzesardo",
    "NODE_ENV": "production",
    "PUBLIC_BASE_URL": "https://nabzesardo.ir"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nabzesardo-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "nabzesardo-uploads"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
