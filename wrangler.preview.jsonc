{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nabzesardo-cloudflare",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {
    "vars": {
      "CLOUDFLARE_WORKER": "1",
      "DATA_DIR": "/tmp/nabzesardo-preview",
      "NODE_ENV": "production",
      "PUBLIC_BASE_URL": "https://nabzesardo.ir",
      "PREVIEW_READONLY": "1",
      "CLOUDFLARE_PRIMARY": "0",
      "CUTOVER_MODE": "cloudflare-only",
      "AUTO_DISTRIBUTION_ENABLED": "0",
      "CLOUDFLARE_ASSET_VERSION": "__PREVIEW_ASSET_VERSION__"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "nabzesardo-editorial-preview",
        "database_id": "__PREVIEW_D1_DATABASE_ID__"
      }
    ],
    "ai": {
      "binding": "AI"
    }
  },
  "preview_urls": true,
  "workers_dev": true
}
